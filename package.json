{
  "name": "travelaura",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test:rules": "node --test tests/firebase.test.js",
    "test:browser": "playwright test",
    "test:firebase": "XDG_CONFIG_HOME=\"$PWD/.firebase/cli\" firebase emulators:exec --project demo-travelaura --only auth,firestore,storage \"npm run test:rules && npm run test:browser\"",
    "seed:firebase": "node scripts/seed-firestore.js",
    "test:seed": "XDG_CONFIG_HOME=\"$PWD/.firebase/cli\" firebase emulators:exec --project demo-travelaura --only firestore \"node --test tests/seed.test.js\""
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "autoprefixer": "latest",
    "firebase": "^12.19.0",
    "lucide-react": "latest",
    "postcss": "latest",
    "react": "latest",
    "react-dom": "latest",
    "react-router-dom": "latest",
    "tailwindcss": "latest",
    "vite": "latest"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@playwright/test": "^1.63.0",
    "firebase-tools": "^15.30.1"
  }
}
